{
  "_comment": [
    "ARTEFAKT 2 — test_targets.json (şablon).",
    "",
    "{TARGET_URL} yer tutucusu ORTAM DEĞİŞKENİNDEN okunur; kod içinde hiçbir üçüncü parti",
    "adres gömülü değildir. TARGET_URL tanımlı değilse run_load_test.py çalışmaz (exit 2).",
    "Örnek: export TARGET_URL=https://staging.sirketiniz.com",
    "",
    "Desteklenen alanlar:",
    "  target_url                 : ZORUNLU. {TARGET_URL}, {run}, {ctx} yer tutucuları olabilir.",
    "  name                       : raporlarda görünen ad (opsiyonel).",
    "  scenario                   : 'email-verify' ise e-posta doğrulama adımı çalışır.",
    "  form_fields                : alan adı -> değer. Değerlerde {email} ve {password}",
    "                               runtime'da ilgili context'in hesabından doldurulur.",
    "  submit_selector            : (opsiyonel) gönder düğmesi; verilmezse selectors.json",
    "                               'submit_button' zinciri kullanılır.",
    "  success_selector           : başarı göstergesi (verilmezse katalogdaki 'success').",
    "  error_selector             : (opsiyonel) hata göstergesi; bulunursa hedef başarısız sayılır.",
    "  success_url_regex          : (opsiyonel) gönderim sonrası URL eşleşmesi.",
    "  requires_email_verification: true ise IMAP dinlenir, doğrulama linki tıklanır.",
    "                               Yalnızca scenario='email-verify' ile birlikte geçerlidir.",
    "  verification_subject_regex : konu filtresi (örn. TR/EN doğrulama e-postaları).",
    "  verification_link_regex    : (opsiyonel) gövdede link seçme regex'i.",
    "  wait_after_submit_ms       : (opsiyonel) gönderim sonrası bekleme (varsayılan 1500).",
    "  captcha_selector           : (opsiyonel) bu satıra özel CAPTCHA seçicisi.",
    "  tags                       : (opsiyonel) rapor etiketleri."
  ],
  "targets": [
    {
      "name": "kayit-formu",
      "target_url": "{TARGET_URL}/register",
      "scenario": "email-verify",
      "form_fields": {
        "email": "{email}",
        "password": "{password}",
        "password_confirm": "{password}",
        "first_name": "Yuk",
        "last_name": "Testi"
      },
      "success_selector": "[data-testid='success'], .notice.success, text=/ho[şs] geldin|başar|success/i",
      "error_selector": "[data-testid='error'], .notice.error, [role='alert']",
      "requires_email_verification": true,
      "verification_subject_regex": "(doğrula|dogrula|verify|confirm|aktivasyon|activate)",
      "wait_after_submit_ms": 1500,
      "tags": ["signup", "smoke"]
    }
  ]
}
